{
  "name": "@tinyhumansai/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "TypeScript SDK and CLI for the TinyHumans backend",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinyhumansai/sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "tinyhumans": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "gen:cli": "node scripts/gen-cli-commands.mjs",
    "build": "node scripts/gen-cli-commands.mjs && tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
